---
/**
 * A page that sends the reader on to another spec page. A meta refresh drops
 * the URL's `#anchor`, so a script redirects first, keeping the anchor or
 * mapping it through `anchors` (old anchor → new href) when the section moved
 * to another page. The meta refresh is the fallback without JavaScript.
 */
interface Props {
  /** The page to send the reader to. */
  to: string;
  /** Old anchors whose sections now live elsewhere, mapped to their new href. */
  anchors?: Record<string, string>;
}

const { to, anchors = {} } = Astro.props;
const canonical = new URL(to, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to {to}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical.href} />
    <script is:inline define:vars={{ to, anchors }}>
      const anchor = decodeURIComponent(location.hash.slice(1));
      location.replace(anchors[anchor] ?? (anchor ? `${to}#${anchor}` : to));
    </script>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
  </head>
  <body>
    <a href={to}>Redirecting to {to}</a>
  </body>
</html>
