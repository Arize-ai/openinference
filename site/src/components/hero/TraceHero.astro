---
/**
 * The landing page's trace hero: one support-agent run replayed on a single
 * clock. A lens at the top shows what the person sees (the session) or what
 * runs (the agent's code); under it, the OpenInference trace it records and
 * the span in view. It is the right half of the split hero. See DESIGN.md
 * ("Trace hero").
 *
 * The server renders the finished run, so the hero reads without
 * JavaScript; the script in engine.ts then replays it. Everything the hero
 * shows comes from model.ts.
 */
import { createHighlighter, type ThemedToken, type ThemeRegistrationAny } from "shiki";

import { shikiConfig } from "../../lib/shiki.mjs";
import { GLYPHS, kindClass } from "./glyphs";
import {
  ANSWER,
  ANSWER_SPAN,
  attributesAt,
  CODE,
  formatClock,
  formatDuration,
  GUIDES,
  LABEL_FLIP,
  PRE_ROLL,
  QUESTION,
  RETRY,
  SPANS,
  statusOf,
  STEP_SPANS,
  STEPS,
  T,
  TICKS,
  TRACE_ID,
  xAt,
} from "./model";

/** The detail's attribute rows: the most any span records. */
const ATTRIBUTE_SLOTS = Math.max(...SPANS.map((span) => span.attributes.length));

// The code is highlighted like the site's code blocks (the Pierre theme, light
// and dark), a line at a time so the replay can light the one running.
const themes = shikiConfig.themes as { light: ThemeRegistrationAny; dark: ThemeRegistrationAny };
const highlighter = await createHighlighter({ themes: [themes.light, themes.dark], langs: ["python"] });
const codeLines = highlighter.codeToTokens(CODE, { lang: "python", themes }).tokens;
const styleOf = (token: ThemedToken) =>
  Object.entries(token.htmlStyle ?? {})
    .map(([property, value]) => `${property}:${value}`)
    .join(";");

const root = SPANS[0]!;
const finalAttributes = attributesAt(root, T);
const workedFor = `${(SPANS[ANSWER_SPAN]!.start / 1000).toFixed(1)}s`;
const stepMeta = (index: number) =>
  [STEPS[index]!.note, formatDuration(STEP_SPANS[index]!.end - STEP_SPANS[index]!.start)].filter(Boolean).join(" · ");
const markAt = (ms: number) => `${((ms - PRE_ROLL) / (T - PRE_ROLL)) * 100}%`;
const pct = (value: number) => `${Math.round(value * 100) / 100}%`;
const glyph = (kind: keyof typeof GLYPHS) => `<svg viewBox="0 0 16 16" aria-hidden="true">${GLYPHS[kind]}</svg>`;
---

<section class="trace-hero" aria-label="An agent run, and the trace OpenInference records for it">
  <div class="stage" data-trace-hero>
    <div class="tabs" role="group" aria-label="View">
      <button type="button" class="eyebrow" data-view="chat" aria-pressed="true">Session</button>
      <button type="button" class="eyebrow" data-view="code" aria-pressed="false">Code</button>
    </div>

    <div class="lens" data-panes>
        <div class="chat" data-pane="chat" data-steps="closed">
          <p class="question" data-group="root" data-span="0">{QUESTION}</p>
          <div class="agent-line">
            <p class="who eyebrow" data-agent>
              <span class="who-glyph" set:html={glyph("AGENT")} />Support agent
            </p>
            <button type="button" class="summary" data-summary aria-expanded="false" aria-controls="trace-hero-steps">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4"></path></svg>
              <span class="summary-text" data-summary-text>Worked for {workedFor}</span>
            </button>
          </div>
          <ol class="steps" id="trace-hero-steps">
            {
              STEPS.map((step, index) => (
                <li class="step" data-step={index} data-group={step.group} data-state="done">
                  <span class="step-icon" aria-hidden="true">
                    <span class="spinner" />
                    <svg class="check" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" /></svg>
                  </span>
                  <span class="step-text">{step.text}</span>
                  <span class="step-meta" data-step-meta>{stepMeta(index)}</span>
                </li>
              ))
            }
          </ol>
          <p class="answer" data-answer data-group="answer" data-span={ANSWER_SPAN}>
            <span data-answer-text>{ANSWER}</span>
          </p>
        </div>

        <div class="code" data-pane="code" hidden>
          <pre class="code-body" data-code><code>{
            codeLines.map((line, index) => (
              <span class="line" data-line={index + 1}><span class="no" aria-hidden="true">{index + 1}</span><span class="text">{line.length ? line.map((token) => <span class="tok" style={styleOf(token)}>{token.content}</span>) : " "}</span></span>
            ))
          }</code></pre>
        </div>
    </div>

    <div class="trace">
        <div class="scroll">
          <div
            class="waterfall"
            data-waterfall
            role="img"
            aria-label="The trace, as a tree of spans beside a timeline: the support_agent span, with a guardrail, three model calls, a skill load and a help-center search running in parallel, then code that calls the billing API. One HTTP request fails with a 500 and is retried; the person never sees it."
          >
            <div class="axis">
              <span class="trace-label"><span class="eyebrow">Trace</span><span class="trace-id">{TRACE_ID}</span></span>
              <span class="ticks">
                {TICKS.map((tick, index) => <span class:list={["tick", { first: index === 0 }]} style={`left:${pct(tick.x)}`}>{tick.label}</span>)}
                <span class="chip" data-chip hidden></span>
              </span>
            </div>
            <div class="rows">
              <div class="lanes" aria-hidden="true">
                {TICKS.map((tick) => <span class="grid" style={`left:${pct(tick.x)}`} />)}
                <span class="playhead" data-playhead hidden></span>
              </div>
              {
                SPANS.map((span, index) => (
                  <div
                    class:list={["row", kindClass(span.kind), { error: span.error }]}
                    data-row={index}
                    data-state="done"
                    style={`--depth:${span.depth};--x:${pct(xAt(span.start))};--w:${pct(xAt(span.end) - xAt(span.start))}`}
                  >
                    <span class="band" data-group={span.group} data-span={index} />
                    <span class="node">
                      {GUIDES[index]!.map((guide) => (
                        <span class={`guide ${guide.part}`} data-after={guide.after} style={`--level:${guide.level}`} />
                      ))}
                      <span class="glyph" set:html={glyph(span.kind)} />
                      <span class="name">{span.name}</span>
                      {span.note && <span class="code-tag">{span.note}</span>}
                    </span>
                    <span class="lane">
                      {index === RETRY.row && (
                        <span class="retry" data-after={RETRY.after} style={`left:${pct(RETRY.from)};width:${pct(RETRY.to - RETRY.from)}`} />
                      )}
                      <span class="bar" />
                      <span
                        class="bar-label"
                        data-duration
                        hidden={index === 0}
                        style={
                          xAt(span.end) > LABEL_FLIP
                              ? `right:calc(${pct(100 - xAt(span.start))} + 6px)`
                              : `left:calc(${pct(xAt(span.end))} + 6px)`
                        }
                      >
                        {formatDuration(span.end - span.start)}
                      </span>
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="detail" data-detail>
          <p class="detail-head">
            <span class="glyph" data-detail-glyph set:html={glyph(root.kind)} />
            <span class="detail-name" data-detail-name>{root.name}</span>
            <span class="eyebrow detail-status" data-detail-status data-status="OK">{statusOf(root)}</span>
            <span class="detail-duration" data-detail-duration>{formatDuration(T)}</span>
          </p>
          <dl class="attributes" data-attributes>
            {
              Array.from({ length: ATTRIBUTE_SLOTS }, (_, index) => {
                const attribute = finalAttributes[index];
                return (
                  <div class="attribute" data-attribute hidden={!attribute}>
                    <dt>{attribute?.key}</dt>
                    <dd>{attribute?.value}</dd>
                  </div>
                );
              })
            }
          </dl>
        </div>
    </div>

    <div class="controls">
      <button type="button" class="play" data-play aria-label="Replay">
        <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7-4.5z"></path></svg>
        <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9M11 3.5v9"></path></svg>
      </button>
      <div class="track">
        <input type="range" min={PRE_ROLL} max={T} step="10" value={T} aria-label="Trace time" data-scrubber style="--p:100%" />
        <span class="marks" aria-hidden="true">
          {SPANS.map((span) => <span class:list={["mark", { error: span.error }]} style={`left:${markAt(span.start)}`} />)}
        </span>
      </div>
      <span class="time" data-time>{formatClock(T)} / {formatClock(T)}</span>
    </div>
  </div>
</section>

<script>
  import { mount } from "./engine";

  for (const root of document.querySelectorAll<HTMLElement>("[data-trace-hero]")) mount(root);
</script>

<style>
  /*
   * The stage: no frame. One column (tabs, the lens, the trace, the span in
   * view, the controls), its structure spacing and one hairline (under the
   * tabs). Heights are fixed so nothing moves while the
   * run plays.
   */
  .trace-hero { min-width: 0; }
  .stage {
    /* The lens: the session or the code, one height so switching doesn't move the trace. */
    --lens: 136px;
    /* The span tree: its column, and each level's indent. */
    --tree: clamp(196px, 32%, 220px);
    --row: 20px;
    --indent: 18px;
  }

  .tabs { display: flex; gap: var(--space-5); border-bottom: 1px solid var(--rule); }
  .tabs button {
    position: relative;
    height: 40px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .tabs button:hover, .tabs button[aria-pressed="true"] { color: var(--fg); }
  .tabs button[aria-pressed="true"]::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px;
    height: 1px;
    background: var(--fg);
  }

  .lens { position: relative; height: var(--lens); }

  /* --- Session: the chat as the person sees it ---------------------------- */
  .chat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    padding-top: var(--space-2);
    overflow: hidden auto;
    scrollbar-width: none;
  }
  .chat[hidden] { display: none; }
  .question {
    align-self: flex-end;
    max-width: 80%;
    padding: var(--space-2) var(--space-4);
    background: var(--tint);
    font-size: var(--text-small);
    line-height: 1.5;
    transition: background-color 0.15s;
  }
  .question.lit, .question:hover { background: color-mix(in srgb, var(--fg) 11%, transparent); }
  .agent-line { display: flex; align-items: center; gap: var(--space-4); margin-top: var(--space-2); }
  .who { display: flex; align-items: center; gap: var(--space-2); }
  .who[hidden] { display: none; }
  .who-glyph { display: inline-flex; width: 14px; height: 14px; }
  .who-glyph :global(svg) { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  .who-glyph :global(.fill) { fill: currentColor; stroke: none; }
  .summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    border: 0;
    background: none;
    color: var(--dim);
    font: inherit;
    font-size: var(--text-small);
    cursor: pointer;
  }
  .summary:hover { color: var(--fg); }
  .summary[hidden] { display: none; }
  .summary svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.2s; }
  .summary[aria-expanded="true"] svg { transform: rotate(90deg); }

  .steps { display: grid; width: 100%; margin-top: var(--space-2); padding: 0; list-style: none; }
  .chat[data-steps="closed"] .steps { display: none; }
  .step {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 28px;
    color: var(--soft);
    font-size: var(--text-small);
    animation: rise 0.3s ease both;
    transition: background-color 0.15s, color 0.15s;
  }
  .step[data-state="pending"] { display: none; }
  .step.lit, .step:hover { color: var(--fg); }
  .step-icon { display: grid; place-items: center; width: 14px; height: 14px; flex-shrink: 0; }
  .spinner, .check { grid-area: 1 / 1; display: none; }
  .spinner {
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--rule);
    border-top-color: var(--fg);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  .check { width: 14px; height: 14px; fill: none; stroke: var(--dim); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .step[data-state="open"] .spinner, .step[data-state="done"] .check { display: block; }
  .step-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Work in progress glimmers, as in a real chat: the live summary and the step running. */
  .step[data-state="open"] .step-text, .summary.working .summary-text {
    background: linear-gradient(90deg, var(--dim) 0 30%, var(--fg) 45% 55%, var(--dim) 70% 100%) 0 0 / 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 2s linear infinite;
  }
  .summary.lit { color: var(--fg); }
  .step-meta { color: var(--dim); font: 400 var(--text-micro) / 1 var(--font-mono); white-space: nowrap; }

  .answer {
    margin-top: var(--space-2);
    font-size: var(--text-small);
    line-height: 1.6;
    animation: fade 0.3s ease both;
    transition: background-color 0.15s;
  }
  .answer[hidden] { display: none; }
  .answer { color: var(--soft); }
  .answer.lit, .answer:hover { color: var(--fg); }

  /* --- Code -------------------------------------------------------------- */
  .code { display: flex; flex-direction: column; height: 100%; }
  .code[hidden] { display: none; }
  .code-body { position: relative; flex: 1; min-height: 0; margin: 0; padding-block: var(--space-4); overflow: auto; scrollbar-width: none; mask-image: linear-gradient(transparent, #000 var(--space-5), #000 calc(100% - var(--space-5)), transparent); font: 400 var(--text-micro) / 1.32 var(--font-mono); }
  .line { display: block; padding-right: var(--space-4); white-space: pre; transition: opacity 0.2s, background-color 0.2s; }
  .no { display: inline-block; width: 3ch; margin-right: 2ch; color: var(--dim); text-align: right; opacity: 0.6; font-variant-numeric: tabular-nums; }
  .code-body.is-running .line { opacity: 0.4; }
  .code-body.is-running .line.run { opacity: 0.85; }
  .code-body.is-running .line.act { opacity: 1; background: var(--tint); }
  .line.run .no, .line.act .no { color: var(--fg); opacity: 1; }
  /* Pierre's dark colours with the site's dark theme. */
  :global(:root[data-theme="dark"]) .tok { color: var(--shiki-dark) !important; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .tok { color: var(--shiki-dark) !important; }
  }

  /* --- Trace: the span tree beside its timeline --------------------------- */
  .trace { margin-top: var(--space-3); }
  .waterfall { font: 400 var(--text-micro) / 1 var(--font-mono); }
  .waterfall * { pointer-events: none; }
  .axis { display: grid; grid-template-columns: var(--tree) minmax(0, 1fr); height: 36px; align-items: center; }
  .trace-label { display: flex; align-items: baseline; gap: var(--space-2); min-width: 0; padding-right: var(--space-4); }
  .trace-id { overflow: hidden; color: var(--dim); text-overflow: ellipsis; white-space: nowrap; }
  .ticks { position: relative; height: 100%; }
  .tick { position: absolute; top: 50%; color: var(--dim); font-variant-numeric: tabular-nums; transform: translate(-50%, -50%); }
  .tick.first { transform: translate(0, -50%); }
  /* The time, riding the playhead. */
  .chip {
    position: absolute;
    top: 50%;
    z-index: 1;
    padding: 2px 5px;
    background: var(--fg);
    color: var(--bg);
    font-variant-numeric: tabular-nums;
    transform: translate(-50%, -50%);
  }
  .chip[hidden] { display: none; }

  .rows { position: relative; }
  .lanes { position: absolute; inset: 0 0 0 var(--tree); }
  /* Dotted gridlines, as on a drawing. */
  .grid {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: repeating-linear-gradient(to bottom, var(--rule) 0 1px, transparent 1px 4px);
  }
  .playhead { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--fg); opacity: 0.5; }
  .playhead[hidden] { display: none; }

  .row {
    --c: var(--kind-http);
    position: relative;
    display: grid;
    grid-template-columns: var(--tree) minmax(0, 1fr);
    height: var(--row);
    transition: opacity 0.3s;
  }
  .row[data-state="pending"] { opacity: 0; visibility: hidden; }
  /* A span eases in as it starts. */
  .row:not([data-state="pending"]) .node, .row:not([data-state="pending"]) .lane { animation: enter 0.35s ease-out both; }
  .kind-agent { --c: var(--kind-agent); }
  .kind-llm { --c: var(--kind-llm); }
  .kind-tool { --c: var(--kind-tool); }
  .kind-retriever { --c: var(--kind-retriever); }
  .kind-embedding { --c: var(--kind-embedding); }
  .kind-reranker { --c: var(--kind-reranker); }
  .kind-guardrail { --c: var(--kind-guardrail); }
  .row.error[data-state="done"] { --c: var(--accent); }

  .band { position: absolute; inset: 0 calc(-1 * var(--space-2)); transition: background-color 0.12s; }
  /* Bars, names and glyphs ignore the pointer, so a row's band receives it. */
  .waterfall .band { pointer-events: auto; }
  .row.on .band { background: var(--tint); }

  /* The tree cell: indented by depth, the kind's glyph and the span's name. */
  .node {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    padding-left: calc(var(--depth) * var(--indent));
    padding-right: var(--space-4);
    color: var(--fg);
    white-space: nowrap;
  }
  .name { overflow: hidden; text-overflow: ellipsis; transition: opacity 0.15s; }
  .code-tag { color: var(--dim); }
  .row[data-state="open"] .code-tag { display: none; }
  .row.error[data-state="done"] .code-tag { color: var(--accent); }

  /* The hierarchy: a column under each glyph, an arm across to each child. */
  .guide {
    position: absolute;
    left: calc(var(--level) * var(--indent) + 7px);
    background: var(--rule);
    transition: opacity 0.35s ease-out;
  }
  .guide.off { opacity: 0; }
  .guide.up { top: 0; height: 50%; width: 1px; }
  .guide.down { top: 50%; height: 50%; width: 1px; }
  .guide.stem { top: calc(50% + 9px); bottom: 0; width: 1px; }
  .guide.arm { top: 50%; height: 1px; width: calc(var(--indent) - 10px); }

  /* The kind's glyph, bare, in its colour: no tile, no frame. */
  .glyph { display: inline-flex; width: 14px; height: 14px; flex-shrink: 0; color: var(--c); transition: opacity 0.15s; }
  .glyph :global(svg) { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  .glyph :global(.fill) { fill: currentColor; stroke: none; }

  .lane { position: relative; }
  /*
   * Each span is a solid rectangle in its kind's full colour. A span still
   * running is only its dashed outline; it fills in when the span ends.
   */
  .bar {
    position: absolute;
    left: var(--x);
    top: 50%;
    width: var(--w);
    min-width: 3px;
    height: 10px;
    border: 1px solid var(--c);
    background: var(--c);
    transform: translateY(-50%);
    transition: opacity 0.2s, background-color 0.3s ease-out;
  }
  .row[data-state="open"] .bar { border-style: dashed; background: transparent; }
  /* An agent is the envelope around the work: the outline alone. */
  .kind-agent .bar { background: none; border-color: color-mix(in srgb, var(--c) 60%, transparent); }
  /* A failure is hatched, so it reads without colour too. */
  .row.error[data-state="done"] .bar {
    background: repeating-linear-gradient(-45deg, var(--c) 0 2px, color-mix(in srgb, var(--c) 45%, var(--bg)) 2px 4px);
  }
  .bar-label { position: absolute; top: 50%; color: var(--dim); font-variant-numeric: tabular-nums; white-space: nowrap; transform: translateY(-50%); }
  .row:not([data-state="done"]) .bar-label { visibility: hidden; }
  /* The root spans the whole timeline; its duration is in the detail. */
  .bar-label[hidden] { display: none; }
  .row.error[data-state="done"] .bar-label { color: var(--accent); }
  /* The retry: from the failed request's end, down to the next attempt. */
  .retry {
    position: absolute;
    bottom: 50%;
    height: var(--row);
    border-left: 1px dashed var(--accent);
    border-bottom: 1px dashed var(--accent);
    opacity: 0.8;
  }
  .retry[hidden] { display: none; }

  /* While something is hovered, everything else steps back. */
  .waterfall.dim .row:not(.on) :is(.bar, .glyph, .bar-label, .retry) { opacity: 0.3; }
  .waterfall.dim .row:not(.on) .name { opacity: 0.45; }

  /* --- The span in view: what OpenInference recorded on it -------------- */
  .detail { padding-top: var(--space-2); font: 400 var(--text-micro) / 1.5 var(--font-mono); }
  .detail-head { --c: var(--dim); display: flex; align-items: center; gap: var(--space-2); height: var(--row); }
  .detail-head[data-kind="agent"] { --c: var(--kind-agent); }
  .detail-head[data-kind="llm"] { --c: var(--kind-llm); }
  .detail-head[data-kind="tool"] { --c: var(--kind-tool); }
  .detail-head[data-kind="retriever"] { --c: var(--kind-retriever); }
  .detail-head[data-kind="embedding"] { --c: var(--kind-embedding); }
  .detail-head[data-kind="reranker"] { --c: var(--kind-reranker); }
  .detail-head[data-kind="guardrail"] { --c: var(--kind-guardrail); }
  .detail-head[data-kind="http"] { --c: var(--kind-http); }
  .detail-head[data-error] { --c: var(--accent); }
  .detail-name { color: var(--fg); }
  .detail-status { margin-left: var(--space-2); }
  .detail-status[data-status="ERROR"] { color: var(--accent); }
  .detail-duration { margin-left: auto; color: var(--dim); font-variant-numeric: tabular-nums; }
  .attributes {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    grid-auto-rows: 16px;
    align-items: center;
    column-gap: var(--space-5);
    height: calc(5 * 16px);
    margin: var(--space-2) 0 0;
  }
  .attribute { display: contents; }
  .attribute[hidden] { display: none; }
  .attribute dt { color: var(--dim); }
  .attribute dd { overflow: hidden; margin: 0; color: var(--fg); text-overflow: ellipsis; white-space: nowrap; }
