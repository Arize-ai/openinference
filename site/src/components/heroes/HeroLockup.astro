---
/**
 * The hero's lockup, solid, over whatever art fills the hero band. Place it
 * inside a positioned element (the hero's art band); it centres itself in
 * that element, 44% down (LOCKUP_Y, shared with hero-photo.ts so the photo's
 * focal point sits behind it).
 */
import BrandArt from "../brand/BrandArt.astro";
import { art } from "../../lib/brand";
import { LOCKUP_Y } from "./hero-photo";

const box = art.lockup.viewBox;
const vars = `--lockup-aspect: ${box.w / box.h}; --lockup-y: ${LOCKUP_Y * 100}%`;
---

<div class="hero-lockup" aria-hidden="true" style={vars}>
  <BrandArt name="lockup" class="lockup" />
</div>

<style>
  .hero-lockup {
    position: absolute;
    inset: 0;
    container-type: size;
    pointer-events: none;
  }
  /* 72% of the band's width (86% under 640px, where it is small) or 69% of
     its height, whichever is less. */
  .hero-lockup :global(.lockup) {
    position: absolute;
    left: 50%;
    top: var(--lockup-y);
    width: min(var(--lockup-share, 72cqw), 69cqh * var(--lockup-aspect));
    height: auto;
    translate: -50% -50%;
    color: var(--fg);
  }
  @container (max-width: 639.98px) {
    .hero-lockup :global(.lockup) { --lockup-share: 86cqw; }
  }
</style>
