---
/**
 * The hero's mark, solid, over whatever art fills the hero band. Place it
 * inside a positioned element (the hero's art band); it centres itself in
 * that element, 44% down (MARK_Y, shared with hero-photo.ts so the photo's
 * focal point sits behind it).
 */
import BrandArt from "../brand/BrandArt.astro";
import { MARK_Y } from "./hero-photo";

const vars = `--mark-y: ${MARK_Y * 100}%`;
---

<div class="hero-mark" aria-hidden="true" style={vars}>
  <BrandArt name="mark" class="mark" />
</div>

<style>
  .hero-mark {
    position: absolute;
    inset: 0;
    container-type: size;
    pointer-events: none;
  }
  /* 46% of the band's height, or 40% of its width on narrow bands. */
  .hero-mark :global(.mark) {
    position: absolute;
    left: 50%;
    top: var(--mark-y);
    width: auto;
    height: min(46cqh, 40cqw);
    translate: -50% -50%;
    color: var(--fg);
  }
</style>
