---
/**
 * The landing page: the root README, or one of its translations. The hero,
 * on the wide frame and all in the first screen: the tagline and the calls
 * to action beside the trace hero (an agent run replayed beside its trace),
 * then the three pillars in a row under both. Then the rest of the README in
 * the content column, with gutter rulers beside the packages. See DESIGN.md
 * ("Landing").
 */
import PageMarkings, { type Run } from "../components/PageMarkings.astro";
import Statement from "../components/Statement.astro";
import TraceHero from "../components/hero/TraceHero.astro";
import { getLatestNews, newsUrl } from "../lib/news";
import { base, directionOf, site } from "../lib/site";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  /** The README's language code. */
  lang?: string;
}

const { lang = "en" } = Astro.props;
const dir = directionOf(lang);
const latest = await getLatestNews();

/** The tagline in two lines that never break: "Telemetry" / "for the AI Frontier". */
const [taglineHead, taglineTail] = (() => {
  const at = site.tagline.indexOf(" for ");
  return at < 0 ? [site.tagline, ""] : [site.tagline.slice(0, at), site.tagline.slice(at + 1)];
})();

/** What OpenInference is made of, each pointing at where to read more. */
const pillars = [
  { name: "Specification", body: "Semantic conventions for agent steps and operations.", href: `${base}spec/` },
  { name: "Instrumentation", body: "Tracing for Python, JavaScript, Java and Go.", href: "#instrumentation" },
  { name: "Vendor agnostic", body: "Plain OpenTelemetry, for any OTLP backend.", href: "#supported-destinations" },
];

// Gutter rulers: alongside the packages, not beside the hero, where they
// would only compete with the demo. Each README section gets a registration
// cross.
const rulerRuns: Run[] = [
  { from: ["#instrumentation", "top"], to: ["#supported-destinations", "top"], fadeOut: 0.2 },
];
---

<BaseLayout>
  <PageMarkings runs={rulerRuns} marks=".readme > h2" />
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-text">
      {
        latest && (
          <a class="latest" href={newsUrl(latest)}>
            <span class="eyebrow">News</span>
            <span class="latest-title">{latest.data.title}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        )
      }
      <h1 id="hero-heading">
        <span class="keep">{taglineHead}</span>{" "}<span class="keep">{taglineTail}</span>
      </h1>
      <p class="lede">{site.lede}</p>
      <div class="actions">
        <a class="button solid" href={`${base}spec/`}>Read the spec</a>
        <a class="button" href={site.repo}>View on GitHub</a>
      </div>
    </div>
    <TraceHero />
    <ul class="pillars" aria-label={`What ${site.name} is`}>
      {
        pillars.map((pillar) => (
          <li>
            <h2>
              <a href={pillar.href}>
                {pillar.name}
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </h2>
            <p>{pillar.body}</p>
          </li>
        ))
      }
    </ul>
  </section>
  <Statement />
  <article class="prose readme" lang={lang} dir={dir}>
    <slot />
  </article>
</BaseLayout>

<style>
  /*
   * The hero, on the wide frame and all in the first screen: the tagline and
   * the calls to action beside the trace demo, then the three pillars in a
   * row under both.
   */
  section.hero {
    grid-column: full;
    display: grid;
    /* The demo takes most of the frame: the trace is the point. */
    grid-template-columns: minmax(0, 6fr) minmax(0, 11fr);
    grid-template-areas: "text demo" "pillars pillars";
    column-gap: var(--space-7);
    row-gap: var(--space-8);
    /* On the wide frame, like the header: the tagline starts under the
       wordmark and the demo ends under the nav. */
    position: relative;
    width: min(var(--frame-max), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding-block: var(--space-8) var(--space-9);
  }
  /* The words, centred on the demo beside them. */
  .hero-text { grid-area: text; align-self: center; container-type: inline-size; }
  section.hero > :global(.trace-hero) { grid-area: demo; }
  /* The newest post, while it's recent: one quiet line over the tagline. */
  .latest {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    max-width: 100%;
    margin-bottom: var(--space-6);
    color: var(--soft);
    font-size: var(--text-small);
    text-decoration: none;
  }
  .latest-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .latest .arrow { color: var(--dim); transition: transform 0.15s, color 0.15s; }
  .latest:hover, .latest:focus-visible { color: var(--fg); }
  .latest:hover .arrow, .latest:focus-visible .arrow { color: var(--accent); transform: translateX(3px); }
  h1 {
    /* Sized to its column, so each of its two lines holds whole. */
    font: 600 var(--text-hero) / 1.04 var(--font-sans);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  h1 .keep { white-space: nowrap; }
  h1 .keep:first-child::after { content: "\A"; white-space: pre; }
  /* One sentence that ties the tagline to the run beside it. */
  .lede { max-width: 32ch; margin-top: var(--space-6); color: var(--soft); font-size: var(--text-hero-lede); line-height: 1.45; text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }

  /* What the project is made of, set off by type and space alone: each
     pointing at where to read more. */
  .pillars { grid-area: pillars; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-7); padding: 0; list-style: none; }
  .pillars li { display: grid; gap: var(--space-1); }
  /* The title is the link; the sentence under it stays quiet. */
  .pillars h2 { font: 600 var(--text-title) / 1.25 var(--font-sans); letter-spacing: -0.01em; }
  .pillars h2 a { display: inline-flex; align-items: baseline; gap: var(--space-2); color: var(--fg); text-decoration: none; }
  .pillars .arrow { color: var(--dim); font-weight: 400; transition: transform 0.15s, color 0.15s; }
  .pillars h2 a:hover .arrow, .pillars h2 a:focus-visible .arrow { color: var(--accent); transform: translateX(3px); }
  .pillars p { color: var(--dim); font-size: var(--text-small); line-height: 1.5; text-wrap: pretty; }

  /*
   * The README fills the page column, text and tables alike, so it has one
   * left edge and one right edge and sits on the hero's centre line. Each
   * `##` opens a section, set apart by space alone.
   */
  .readme { padding-bottom: var(--space-8); }
  .readme > :global(* + *) { margin-top: var(--space-4); }
  /* Sections are set apart by type and space alone: no rules between them. */
  .readme > :global(h2) {
    margin-top: calc(var(--space-9) + var(--space-6));
    font-size: var(--text-feature);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
  }
  .readme > :global(h2:first-child) { margin-top: 0; }
  .readme > :global(h2 + p) { color: var(--soft); }
  /* `###` (Libraries, Examples) labels the table under it, in mono caps. */
  .readme > :global(h3) {
    margin-top: var(--space-7);
    color: var(--dim);
    font: 500 var(--text-micro) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
  }
  .readme > :global(h2 + h3) { margin-top: var(--space-6); }
  .readme > :global(h3 + *) { margin-top: var(--space-3); }
  /* A note after a table ("Requires Go 1.25+") reads as a footnote. */
  .readme > :global(.table-scroll + p) { margin-top: var(--space-5); color: var(--soft); font-size: var(--text-small); }
  /* The README's lists (destinations, community links): rows without bullets or rules. */
  .readme > :global(ul) { display: grid; gap: var(--space-3); padding: 0; list-style: none; }

  /* A narrow laptop: the demo keeps enough room to set the session beside the trace. */
  @media (max-width: 1360px) {
    section.hero { grid-template-columns: minmax(0, 5fr) minmax(0, 12fr); }
  }
  /*
   * Narrower: the text and pillars, then the demo under them, on the page
   * column so the hero and the README share one left edge.
   */
  @media (max-width: 1240px) {
    section.hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "text" "pillars" "demo";
      row-gap: var(--space-8);
      width: auto;
      margin-inline: 0;
      grid-column: content;
    }
    .hero-text { align-self: start; }
    .pillars { column-gap: var(--space-6); }
  }
  /*
   * While the page markings show (above the phone breakpoint), keep every
   * column clear of their rulers: the gutter's width again inside them.
   */
  @media (min-width: 721px) and (max-width: 1240px) {
    :global(main.page-grid) {
      --landing-margin: calc(var(--gutter) + var(--space-6));
      grid-template-columns:
        [full-start] minmax(var(--landing-margin), 1fr)
        [content-start] minmax(0, var(--page-max))
        [content-end] minmax(var(--landing-margin), 1fr)
        [full-end];
    }
  }
  @media (max-width: 720px) {
    section.hero { row-gap: var(--space-7); padding-block: var(--space-7) var(--space-8); }
    .pillars { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-5); }
    .readme { padding-bottom: var(--space-7); }
    .readme > :global(h2) { margin-top: var(--space-9); }
  }
</style>
