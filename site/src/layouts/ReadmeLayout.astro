---
/**
 * The landing page: the root README, or one of its translations. The hero,
 * split on the wide frame and all in the first screen: the tagline, the calls
 * to action and three pillars on the left, the trace hero (an agent run
 * replayed beside its trace) on the right. Then the rest of the README
 * in the content column, with page markings in the margins. See DESIGN.md
 * ("Landing").
 */
import PageMarkings, { type Run } from "../components/PageMarkings.astro";
import TraceHero from "../components/hero/TraceHero.astro";
import { base, directionOf, site } from "../lib/site";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  /** The README's language code. */
  lang?: string;
}

const { lang = "en" } = Astro.props;
const dir = directionOf(lang);

/** What OpenInference is made of, each pointing at where to read more. */
const pillars = [
  {
    name: "Specification",
    body: "Semantic conventions for how LLM calls, tools, retrievals and agent steps are recorded as spans.",
    href: `${base}spec/`,
    cta: "Read the spec",
  },
  {
    name: "Instrumentation",
    body: "Libraries that trace popular model providers and agent frameworks in Python, JavaScript, Java and Go.",
    href: "#instrumentation",
    cta: "Browse packages",
  },
  {
    name: "Vendor agnostic",
    body: "Every trace is plain OpenTelemetry. Send it to Arize Phoenix, Arize AX, Dynatrace or any OTLP collector.",
    href: "#supported-destinations",
    cta: "See destinations",
  },
];

// Gutter rulers: alongside the packages, not beside the hero, where they
// would only compete with the demo. Each README section gets a registration
// cross.
const rulerRuns: Run[] = [
  { from: ["#instrumentation", "top"], to: ["#supported-destinations", "top"], fadeOut: 0.2 },
];
---

<BaseLayout>
  <PageMarkings runs={rulerRuns} marks=".readme > h2" />
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-text">
      <div>
        <h1 id="hero-heading">{site.tagline}</h1>
        <p class="lede">
          Trace every model call, tool call, retrieval and agent step with OpenTelemetry, and see what your agent
          actually did.
        </p>
        <div class="actions">
          <a class="button solid" href={`${base}spec/`}>Read the spec</a>
          <a class="button" href={site.repo}>View on GitHub</a>
        </div>
      </div>
      <ul class="pillars" aria-label={`What ${site.name} is`}>
        {
          pillars.map((pillar) => (
            <li>
              <h2>{pillar.name}</h2>
              <a class="eyebrow" href={pillar.href}>
                {pillar.cta} →
              </a>
              <p>{pillar.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <TraceHero />
  </section>
  <article class="prose readme" lang={lang} dir={dir}>
    <slot />
  </article>
</BaseLayout>

<style>
  /*
   * The hero, split on the wide frame and all in the first screen: the
   * tagline, the calls to action and the three pillars down the left, the
   * trace hero on the right.
   */
  section.hero {
    grid-column: full;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--space-8);
    /* Inset from the frame's edges (and its rulers) at every width. */
    width: min(var(--hero-max), 100% - 2 * (var(--gutter) + var(--space-7)));
    margin-inline: auto;
    padding-block: var(--space-8) var(--space-9);
  }
  /* The words at the top, the pillars at the bottom, level with the demo's end. */
  .hero-text { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-7); }
  h1 {
    font: 600 clamp(40px, 3.9vw, 56px) / 1.04 var(--font-sans);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  /* One sentence that ties the tagline to the run beside it. */
  .lede { max-width: 36ch; margin-top: var(--space-5); color: var(--soft); font-size: var(--text-body-lg); line-height: 1.5; text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  /* What the project is made of, set off by type and space alone: each
     pointing at where to read more. */
  .pillars { display: grid; gap: var(--space-6); padding: 0; list-style: none; }
  .pillars li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
  }
  .pillars h2 { font: 600 20px / 1.2 var(--font-sans); letter-spacing: -0.01em; }
  .pillars p { grid-column: 1 / -1; color: var(--soft); font-size: var(--text-small); line-height: 1.5; text-wrap: pretty; }
  .pillars a { color: var(--fg); text-decoration: none; white-space: nowrap; }
  .pillars a:hover, .pillars a:focus-visible { color: var(--accent); }

  /*
   * The README fills the page column, text and tables alike, so it has one
   * left edge and one right edge and sits on the hero's centre line. Each
   * `##` opens a section, ruled from the one before.
   */
  .readme { padding-bottom: var(--space-8); }
  .readme > :global(* + *) { margin-top: var(--space-4); }
  .readme > :global(h2) {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--rule);
    font-size: var(--text-feature);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
  }
  .readme > :global(h2:first-child) { margin-top: 0; }
  .readme > :global(h2 + p) { color: var(--soft); }
  /* `###` (Libraries, Examples) labels the table under it, in mono caps. */
  .readme > :global(h3) {
    margin-top: var(--space-7);
    color: var(--dim);
    font: 500 var(--text-micro) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
  }
  .readme > :global(h2 + h3) { margin-top: var(--space-6); }
  .readme > :global(h3 + *) { margin-top: var(--space-3); }
  /* A note after a table ("Requires Go 1.25+") reads as a footnote. */
  .readme > :global(.table-scroll + p) { margin-top: var(--space-5); color: var(--soft); font-size: var(--text-small); }
  /* The README's lists (destinations, community links) are ruled rows. */
  .readme > :global(ul) { padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .readme > :global(ul > li) { padding-block: var(--space-3); border-bottom: 1px solid var(--rule); }

  /*
   * Narrower: the text and pillars, then the demo under them, on the page
   * column so the hero and the README share one left edge.
   */
  @media (max-width: 1100px) {
    section.hero { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-8); width: 100%; grid-column: content; }
    .hero-text { justify-content: flex-start; gap: var(--space-8); }
    h1 { max-width: 18ch; }
    /* Side by side, each pillar its title, its sentence, then its link. */
    .pillars { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
    .pillars li { grid-template-columns: minmax(0, 1fr); align-content: start; gap: var(--space-2); }
    .pillars p { order: 1; }
    .pillars a { order: 2; margin-top: var(--space-1); }
  }
  /*
   * While the page markings show (above the phone breakpoint), keep every
   * column clear of their rulers: the gutter's width again inside them.
   */
  @media (min-width: 721px) and (max-width: 1100px) {
    :global(main.page-grid) {
      --landing-margin: calc(var(--gutter) + var(--space-6));
      grid-template-columns:
        [full-start] minmax(var(--landing-margin), 1fr)
        [content-start] minmax(0, var(--page-max))
        [content-end] minmax(var(--landing-margin), 1fr)
        [full-end];
    }
  }
  @media (max-width: 720px) {
    section.hero { row-gap: var(--space-7); padding-block: var(--space-7) var(--space-8); }
    .hero-text { gap: var(--space-7); }
    .pillars { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
    .readme { padding-bottom: var(--space-7); }
    .readme > :global(h2) { margin-top: var(--space-7); padding-top: var(--space-7); }
  }
</style>
