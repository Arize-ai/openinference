---
/**
 * The JavaScript API reference's overview: how the packages fit together,
 * every package by group, and a search over every documented export.
 */
import ApiSearch from "../../components/api/ApiSearch.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { renderMarkdown } from "../../lib/api";
import {
  GROUPS,
  getJsNav,
  packages,
  routeOfPackage,
  searchEntries,
  shortName,
} from "../../lib/js-api";
import { routeOf } from "../../lib/site";

const nav = getJsNav();
const entries = searchEntries();
const core = packages.find((pkg) => pkg.slug === "openinference-core");
const conventions = packages.find((pkg) => pkg.slug === "openinference-semantic-conventions");

const install = await renderMarkdown(
  [
    "```sh",
    "# The instrumentation for your library, e.g. OpenAI.",
    "npm install @arizeai/openinference-instrumentation-openai",
    "```",
  ].join("\n"),
);

const groups = GROUPS.map((group) => ({
  ...group,
  packages: packages.filter((pkg) => pkg.group === group.id),
}));

const headings = [
  { depth: 2, slug: "packages", text: "Packages" },
  { depth: 2, slug: "search", text: "Search" },
  ...groups.map((group) => ({ depth: 2, slug: group.id, text: group.label })),
];
---

<DocsLayout
  title="JavaScript API"
  description="API reference for the OpenInference JavaScript packages: the core tracing utilities, the semantic conventions, every instrumentation, and the integrations."
  nav={nav}
  headings={headings}
>
  <h1>JavaScript API</h1>
  <p class="api-lede">
    Reference for the {packages.length} OpenInference packages on npm, generated from their source.
  </p>

  <h2 id="packages">Packages</h2>
  <p>
    Each <strong>instrumentation</strong> package traces one library: install it, register its
    instrumentation with OpenTelemetry at startup, and the library's calls make spans that follow
    the <a href={routeOf("spec/README.md")}>specification</a>. <strong>Integrations</strong> turn
    the spans another SDK makes (the Vercel AI SDK, OpenTelemetry's GenAI conventions, TanStack AI)
    into OpenInference spans. All of them build on two <strong>core</strong> packages:
    {
      core && (
        <a href={routeOfPackage(core)}>
          <code>{core.name}</code>
        </a>
      )
    }, for tracing your own code (<code>withSpan</code>, <code>traceChain</code>), adding context such as
    session and user IDs, and configuring what spans record (<code>TraceConfig</code>); and
    {
      conventions && (
        <a href={routeOfPackage(conventions)}>
          <code>{conventions.name}</code>
        </a>
      )
    }, the attribute names as constants.
  </p>
  <Fragment set:html={install} />

  <h2 id="search">Search</h2>
  <ApiSearch entries={entries} example="withSpan" />

  {
    groups.map((group) => (
      <>
        <h2 id={group.id}>{group.label}</h2>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Package</th>
                <th>{group.id === "instrumentation" ? "Instruments" : "Description"}</th>
                <th>Version</th>
              </tr>
            </thead>
            <tbody>
              {group.packages.map((pkg) => (
                <tr>
                  <td>
                    <a href={routeOfPackage(pkg)}>
                      <code>{group.id === "instrumentation" ? shortName(pkg) : pkg.name}</code>
                    </a>
                  </td>
                  <td>
                    {group.id === "instrumentation" && pkg.instruments.length > 0 ? (
                      <code>{pkg.instruments.join(", ")}</code>
                    ) : (
                      pkg.description
                    )}
                  </td>
                  <td>{pkg.version}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ))
  }
</DocsLayout>
