---
import { getEntry, render } from "astro:content";

import DocsLayout from "../../layouts/DocsLayout.astro";
import { getSpecNav, ledeOf, titleOf } from "../../lib/spec";

const entry = await getEntry("spec", "README");
if (!entry) throw new Error("spec/README.md not found");
const { Content, headings } = await render(entry);
const nav = await getSpecNav(entry.id);
---

<DocsLayout title={titleOf(entry)} description={ledeOf(entry.body)} nav={nav} headings={headings}>
  <Content />
</DocsLayout>
