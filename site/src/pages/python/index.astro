---
/**
 * The Python API reference's overview: how the packages fit together, every
 * package by group, and a search over every documented object.
 */
import ApiSearch from "../../components/api/ApiSearch.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { renderMarkdown } from "../../lib/api";
import {
  GROUPS,
  getPythonNav,
  packages,
  routeOfPackage,
  searchEntries,
  shortName,
} from "../../lib/python-api";
import { routeOf } from "../../lib/site";

const nav = getPythonNav();
const entries = searchEntries();

const install = await renderMarkdown(
  [
    "```sh",
    "# The instrumentor for your library, e.g. OpenAI. It brings in the core packages.",
    "pip install openinference-instrumentation-openai",
    "```",
  ].join("\n"),
);

const groups = GROUPS.map((group) => ({
  ...group,
  packages: packages.filter((pkg) => pkg.group === group.id),
}));

const headings = [
  { depth: 2, slug: "packages", text: "Packages" },
  { depth: 2, slug: "search", text: "Search" },
  ...groups.map((group) => ({ depth: 2, slug: group.id, text: group.label })),
];
---

<DocsLayout
  title="Python API"
  description="API reference for the OpenInference Python packages: the core instrumentation utilities, the semantic conventions, and every instrumentor."
  nav={nav}
  headings={headings}
>
  <h1>Python API</h1>
  <p class="api-lede">
    Reference for the {packages.length} OpenInference packages on PyPI, generated from their source.
  </p>

  <h2 id="packages">Packages</h2>
  <p>
    Each <strong>instrumentation</strong> package traces one library: install it, call its
    instrumentor's <code>instrument()</code> once at startup, and the library's calls make spans
    that follow the <a href={routeOf("spec/README.md")}>specification</a>.
    They are built on two <strong>core</strong> packages:
    <a href={routeOfPackage("openinference-instrumentation")}><code>openinference-instrumentation</code></a>,
    for configuring what spans record (<code>TraceConfig</code>), adding context such as session and
    user IDs, and tracing your own code; and
    <a href={routeOfPackage("openinference-semantic-conventions")}
      ><code>openinference-semantic-conventions</code></a
    >, the attribute names as constants.
  </p>
  <Fragment set:html={install} />

  <h2 id="search">Search</h2>
  <ApiSearch entries={entries} example="using_session" />

  {
    groups.map((group) => (
      <>
        <h2 id={group.id}>{group.label}</h2>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Package</th>
                <th>{group.id === "core" ? "Description" : "Instruments"}</th>
                <th>Version</th>
              </tr>
            </thead>
            <tbody>
              {group.packages.map((pkg) => (
                <tr>
                  <td>
                    <a href={routeOfPackage(pkg.name)}>
                      <code>{group.id === "core" ? pkg.name : shortName(pkg)}</code>
                    </a>
                  </td>
                  <td>
                    {group.id === "core" || pkg.instruments.length === 0 ? (
                      pkg.description
                    ) : (
                      <code>{pkg.instruments.join(", ")}</code>
                    )}
                  </td>
                  <td>{pkg.version}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ))
  }
</DocsLayout>
