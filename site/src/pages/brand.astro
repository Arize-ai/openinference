---
/**
 * Brand guidelines: the OpenInference mark and wordmark, which are used
 * apart, never locked up together. Artwork and measurements come from
 * src/lib/brand.ts. See DESIGN.md ("Brand").
 */
import BrandArt from "../components/brand/BrandArt.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { art, clearSpace, colors, icon, wordmarkPaper } from "../lib/brand";

/** A number to two decimals at most, without trailing zeros. */
const fmt = (n: number) => String(Number((n + 1e-9).toFixed(2)));
type Box = { x: number; y: number; w: number; h: number };
const viewBoxOf = (box: Box, pad: number) =>
  `${fmt(box.x - pad)} ${fmt(box.y - pad)} ${fmt(box.w + 2 * pad)} ${fmt(box.h + 2 * pad)}`;
/** Where to letter the clear space: the middle of each side's margin. */
const sidesOf = (box: Box, space: number): [number, number][] => [
  [box.x + box.w / 2, box.y - space / 2],
  [box.x + box.w / 2, box.y + box.h + space / 2],
  [box.x - space / 2, box.y + box.h / 2],
  [box.x + box.w + space / 2, box.y + box.h / 2],
];

const M = art.mark.viewBox;
const W = art.wordmark.viewBox;
const markSpace = clearSpace.mark;
const wordSpace = clearSpace.wordmark;

const downloads = {
  mark: [
    { label: "Mark", file: art.mark.file, url: art.mark.url },
    { label: "Icon", file: icon.file, url: icon.url },
  ],
  wordmark: [
    { label: "Wordmark", file: art.wordmark.file, url: art.wordmark.url },
    { label: "Wordmark, paper", file: wordmarkPaper.file, url: wordmarkPaper.url },
  ],
};

const swatches = [
  { name: "Ink", hex: colors.ink, class: "ink" },
  { name: "Paper", hex: colors.paper, class: "paper" },
  { name: "Signal", hex: colors.signal, class: "signal" },
  { name: "Black", hex: colors.black, class: "black" },
];
---

<BaseLayout title="Brand guidelines" description="The OpenInference mark and wordmark: files, clear space, colour and typography.">
  <div class="brand">
    <header class="page-head">
      <h1>Brand</h1>
      <p class="intro">The mark and the wordmark stand apart. Use the files; never redraw them.</p>
    </header>

    <section id="mark" aria-labelledby="mark-heading">
      <div class="section-head">
        <h2 id="mark-heading">Mark</h2>
        <ul class="downloads">
          {downloads.mark.map((d) => <li><a class="button" href={d.url} download={d.file}>{d.label} ↓</a></li>)}
        </ul>
      </div>
      <div class="grid two">
        <figure class="panel paper"><div class="stage hero-stage"><BrandArt name="mark" label="OpenInference mark, ink on paper" class="show-mark" /></div></figure>
        <figure class="panel ink"><div class="stage hero-stage"><BrandArt name="mark" label="OpenInference mark, paper on ink" class="show-mark" /></div></figure>
      </div>
    </section>

    <section id="wordmark" aria-labelledby="wordmark-heading">
      <div class="section-head">
        <h2 id="wordmark-heading">Wordmark</h2>
        <ul class="downloads">
          {downloads.wordmark.map((d) => <li><a class="button" href={d.url} download={d.file}>{d.label} ↓</a></li>)}
        </ul>
      </div>
      <div class="grid one">
        <figure class="panel paper"><div class="stage word-stage"><BrandArt name="wordmark" label="OpenInference wordmark, ink on paper" class="show-word" /></div></figure>
        <figure class="panel ink"><div class="stage word-stage"><BrandArt name="wordmark" label="OpenInference wordmark, paper on ink" class="show-word" /></div></figure>
      </div>
    </section>

    <section id="space" aria-labelledby="space-heading">
      <h2 id="space-heading">Clear space</h2>
      <div class="grid space-grid">
        <figure class="panel paper">
          <div class="stage">
            <svg class="diagram space-mark" viewBox={viewBoxOf(M, markSpace + 53)} role="img" aria-label="One bolt diameter clear on every side of the mark">
              <rect class="st da" x={M.x - markSpace} y={M.y - markSpace} width={M.w + 2 * markSpace} height={M.h + 2 * markSpace} />
              <rect class="g" x={M.x} y={M.y} width={M.w} height={M.h} />
              <BrandArt name="mark" nested />
              <g class="lab" font-size="84" text-anchor="middle">{sidesOf(M, markSpace).map(([x, y]) => <text {x} y={y + 29}>d</text>)}</g>
            </svg>
          </div>
          <figcaption><i>d</i> · one bolt diameter</figcaption>
        </figure>
        <figure class="panel paper">
          <div class="stage">
            <svg class="diagram" viewBox={viewBoxOf(W, wordSpace + 140)} role="img" aria-label="One cap height clear on every side of the wordmark">
              <rect class="st da" x={W.x - wordSpace} y={W.y - wordSpace} width={W.w + 2 * wordSpace} height={W.h + 2 * wordSpace} />
              <rect class="g" x={W.x} y={W.y} width={W.w} height={W.h} />
              <BrandArt name="wordmark" nested />
              <g class="lab" font-size="420" text-anchor="middle">{sidesOf(W, wordSpace).map(([x, y]) => <text {x} y={y + 145}>c</text>)}</g>
            </svg>
          </div>
          <figcaption><i>c</i> · one cap height</figcaption>
        </figure>
      </div>
    </section>

    <section id="colour" aria-labelledby="colour-heading">
      <h2 id="colour-heading">Colour</h2>
      <ul class="grid four swatches">
        {
          swatches.map((s) => (
            <li class:list={["swatch", s.class]}>
              <b>{s.name}</b>
              <span>{s.hex}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="type" aria-labelledby="type-heading">
      <h2 id="type-heading">Typography</h2>
      <div class="grid two faces">
        <div class="face">
          <p class="sample sans" aria-hidden="true">Aa</p>
          <p class="face-name">Urbanist</p>
        </div>
        <div class="face">
          <p class="sample mono" aria-hidden="true">Aa</p>
          <p class="face-name">Geist Mono</p>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .brand { padding-block: var(--space-8) 0; }

  section { margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--rule); scroll-margin-top: var(--header-height); }
  h2 { margin-bottom: var(--space-5); font: 600 var(--text-feature) / 1.1 var(--font-sans); letter-spacing: var(--tracking-tight); }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3) var(--space-5); margin-bottom: var(--space-5); }
  .section-head h2 { margin-bottom: 0; }
  .downloads { display: flex; flex-wrap: wrap; gap: var(--space-2); padding: 0; list-style: none; }

  .grid { display: grid; gap: var(--space-4); padding: 0; list-style: none; }
  .one { grid-template-columns: minmax(0, 1fr); }
  .two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .space-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }

  /* Panels keep a fixed ground in both themes, so artwork always shows as specified. */
  .panel { display: flex; flex-direction: column; margin: 0; border: 1px solid var(--rule); }
  .panel.paper { background: var(--color-white); color: var(--color-ink); border-color: var(--color-rule); }
  .stage { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 220px; padding: var(--space-6); }
  .hero-stage { aspect-ratio: 1; }
  .stage :global(.show-mark) { width: auto; height: 38%; max-height: 180px; }
  .word-stage { min-height: 260px; }
  .stage :global(.show-word) { width: min(62%, 480px); }

  figcaption, .swatch span, .face-name {
    font: 500 var(--text-micro) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
  }
  figcaption i { font-style: normal; text-transform: none; }
  .panel figcaption { padding: 10px 14px; border-top: 1px solid var(--color-rule); color: var(--color-dim); }

  /* Clear-space diagrams: guides in the panel's ink at low opacity. */
  .diagram { width: 100%; height: auto; overflow: visible; }
  .diagram :global(*) { vector-effect: non-scaling-stroke; }
  .diagram :global(.g) { fill: none; stroke: currentColor; stroke-width: 1; stroke-opacity: 0.35; }
  .diagram :global(.st) { fill: none; stroke: currentColor; stroke-width: 1.25; stroke-opacity: 0.85; }
  .diagram :global(.da) { stroke-dasharray: 5 4; }
  .diagram .lab { fill: currentColor; font-family: var(--font-mono); font-weight: 500; }
  .diagram.space-mark { max-width: 200px; }

  /* Colour */
  .swatch { display: flex; flex-direction: column; justify-content: flex-end; gap: 2px; min-height: 180px; padding: 14px; border: 1px solid var(--rule); }
  .swatch b { margin-bottom: var(--space-1); font: 600 22px / 1.1 var(--font-sans); }
  .swatch span { opacity: 0.85; }
  .ink { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .paper { background: var(--color-paper); color: var(--color-ink); }
  .signal { background: var(--color-signal); color: var(--color-ink); border-color: var(--color-signal); }
  .black { background: var(--color-black); color: var(--color-white); border-color: var(--color-black); }

  /* Typography */
  .face { padding-top: var(--space-4); border-top: 1px solid var(--fg); }
  .sample { font-size: clamp(96px, 16vw, 180px); line-height: 1; }
  .sample.sans { font-family: var(--font-sans); font-weight: 600; }
  .sample.mono { font-family: var(--font-mono); font-weight: 500; }
  .face-name { margin-top: var(--space-3); color: var(--dim); }

  @media (max-width: 840px) {
    .space-grid { grid-template-columns: minmax(0, 1fr); }
    .four { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 720px) {
    .brand { padding-top: var(--space-7); }
    section { margin-top: var(--space-7); }
    .two { grid-template-columns: minmax(0, 1fr); }
    .stage { padding: var(--space-5); }
    .word-stage { min-height: 180px; }
  }
</style>
