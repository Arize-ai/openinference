{# Shared helpers for the registry reference pages. #}

{% macro type(attribute) -%}
{%- set oi = (attribute.annotations | default({}, true)).openinference | default({}, true) -%}
{%- if attribute.type is mapping -%}
string (well-known values)
{%- elif oi.encoding == "flattened_list" -%}
flattened list of {% for ns in oi.item_namespaces %}`{{ ns }}.*`{% if not loop.last %}, {% endif %}{% endfor %}
{%- elif oi.encoding == "flattened_object" -%}
flattened object of {% for ns in oi.item_namespaces %}`{{ ns }}.*`{% if not loop.last %}, {% endif %}{% endfor %}
{%- elif oi.encoding == "json" -%}
string (JSON)
{%- else -%}
{{ attribute.type | trim }}
{%- endif -%}
{%- endmacro %}

{% macro stability(attribute) -%}
{%- if attribute.deprecated -%}
Deprecated{% if attribute.deprecated.note %}: {{ attribute.deprecated.note | trim }}{% endif %}
{%- else -%}
{{ attribute.stability | default("development") | title_case }}
{%- endif -%}
{%- endmacro %}

{% macro cell(text) -%}
{{ text | default("", true) | trim | replace("\n", " ") | replace("|", "\\|") }}
{%- endmacro %}

{% macro examples(attribute) -%}
{%- if attribute.examples is sequence and attribute.examples is not string -%}
{%- if "[]" in (attribute.type | string) -%}
{%- for e in attribute.examples %}`{{ e | tojson }}`{% if not loop.last %}, {% endif %}{% endfor %}
{%- else -%}
{%- for e in attribute.examples %}`{{ e | string | replace("|", "\\|") }}`{% if not loop.last %}, {% endif %}{% endfor %}
{%- endif -%}
{%- elif attribute.examples is defined and attribute.examples is not none -%}
`{{ attribute.examples }}`
{%- endif -%}
{%- endmacro %}

{% macro requirement(level) -%}
{%- if level == "required" -%}
Required
{%- elif level == "recommended" -%}
Recommended
{%- elif level == "opt_in" -%}
Opt-In
{%- elif level is mapping and level.conditionally_required -%}
Conditionally Required: {{ level.conditionally_required | trim }}
{%- elif level is mapping and level.recommended -%}
Recommended: {{ level.recommended | trim }}
{%- elif level is mapping and level.opt_in -%}
Opt-In: {{ level.opt_in | trim }}
{%- else -%}
{{ level }}
{%- endif -%}
{%- endmacro %}

{# Link to the page that defines an attribute. Attributes defined in this
   registry carry `provenance.path`; attributes imported from a dependency
   (e.g. `session.id` from OpenTelemetry) do not. #}
{% macro link(attribute, base) -%}
{%- if attribute.provenance is defined and attribute.provenance.path -%}
[`{{ attribute.key }}`]({{ base }}/{{ attribute.key | split_id | first | kebab_case }}.md)
{%- else -%}
[`{{ attribute.key }}`](https://opentelemetry.io/docs/specs/semconv/registry/attributes/{{ attribute.key | split_id | first | kebab_case }}/)
{%- endif -%}
{%- endmacro %}

{% macro enum_tables(attributes) -%}
{% for attribute in attributes | sort(attribute="key") if attribute.type is mapping %}

## `{{ attribute.key }}` values

`{{ attribute.key }}` has the following well-known values. If one of them applies, it MUST be used; otherwise, a custom value MAY be used.

| Value | Description |
| --- | --- |
{% for member in attribute.type.members if not member.deprecated %}
| `{{ member.value }}` | {{ cell(member.brief) }} |
{% endfor %}
{% endfor %}
{%- endmacro %}
