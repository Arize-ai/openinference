{# Constant names that predate the registry and differ from the attribute key.
   Checked first; then `annotations.openinference.constant_key`; then the key. #}
{% set legacy_names = {
  "llm.cost.prompt_details.input": "LLM_COST_INPUT",
  "llm.cost.completion_details.output": "LLM_COST_OUTPUT",
  "llm.prompt_template.template": "PROMPT_TEMPLATE_TEMPLATE",
  "llm.prompt_template.variables": "PROMPT_TEMPLATE_VARIABLES",
  "llm.prompt_template.version": "PROMPT_TEMPLATE_VERSION",
} %}
{# Key prefixes that are constants but not attributes. #}
{% set prefix_constants = [
  {"name": "LLM_TOKEN_COUNT_PROMPT_DETAILS", "key": "llm.token_count.prompt_details", "doc": "Key prefix for additional prompt token count details. Each detail is a separate attribute with this prefix, e.g. llm.token_count.prompt_details.audio. All values are in tokens."},
  {"name": "LLM_TOKEN_COUNT_COMPLETION_DETAILS", "key": "llm.token_count.completion_details", "doc": "Key prefix for additional completion token count details. Each detail is a separate attribute with this prefix, e.g. llm.token_count.completion_details.reasoning. All values are in tokens."},
  {"name": "LLM_COST", "key": "llm.cost", "doc": "Key prefix for cost information. All values are in USD."},
] %}
{# Enums for well-known values, by the attribute that defines them. `extra`
   members are not in the registry and are kept for compatibility. An enum with
   `aliases` wraps the member of that enum with the same name. #}
{% set enums = [
  {"name": "OpenInferenceSpanKind", "key": "openinference.span.kind", "extra": []},
  {"name": "AnnotatorKind", "key": "annotation.annotator_kind", "extra": []},
  {"name": "MimeType", "key": "input.mime_type", "extra": [{"name": "AUDIO_WAV", "value": "audio/wav"}]},
  {"name": "LLMSystem", "key": "llm.system", "extra": []},
  {"name": "LLMProvider", "key": "llm.provider", "extra": []},
  {"name": "DecisionSystem", "key": "decision.system", "extra": [], "aliases": "LLMSystem", "field": "llmSystem"},
  {"name": "DecisionProvider", "key": "decision.provider", "extra": [], "aliases": "LLMProvider", "field": "llmProvider"},
] %}
{% macro const_name(attribute) -%}
{{ legacy_names[attribute.key] if attribute.key in legacy_names else (attribute.const_key | screaming_snake_case) }}
{%- endmacro %}
{# `\u` is written as an entity: javac reads unicode escapes even inside comments. #}
{% macro text(value) -%}
{{ value | default("", true) | trim | replace("\n", " ") | replace("\\u", "&#92;u") | replace("*/", "*&#47;") | replace("<", "&lt;") | replace(">", "&gt;") | replace("@", "&#64;") }}
{%- endmacro %}
{# A declaration that does not fit in the formatter's 120 columns breaks after `=`. #}
{% macro declaration(name, value) -%}
{%- set line = "    public static final String " ~ name ~ ' = "' ~ value ~ '";' -%}
{%- if line | length > 120 -%}
{{ "    public static final String " ~ name ~ " =\n            \"" ~ value ~ "\";" }}
{%- else -%}
{{ line }}
{%- endif -%}
{%- endmacro %}
