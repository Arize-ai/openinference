{% for attribute in ctx.attributes if attribute.key not in object_only_keys and attribute.key not in skipped_keys %}
/**
 * {{ doc(attribute) }}
 */
{{ declaration(const_name(attribute), attribute.key) }}

{% endfor %}
{% for prefix in prefix_constants %}
/**
 * {{ prefix["doc"] }}
 */
{{ declaration(prefix["name"], prefix["key"]) }}

{% endfor %}
export const SemanticConventions = {
{% for attribute in ctx.attributes if attribute.key not in skipped_keys %}
{% if attribute.key in object_only_keys %}
  {{ const_name(attribute) }}: "{{ attribute.key }}",
{% else %}
  {{ const_name(attribute) }},
{% endif %}
{% endfor %}
{% for prefix in prefix_constants %}
  {{ prefix["name"] }},
{% endfor %}
} as const;
{% for enum in enums %}
{% for attribute in ctx.attributes if attribute.key == enum["key"] %}

{% if enum["doc"] %}
/**
 * {{ enum["doc"] }}
 */
{% endif %}
export enum {{ enum["name"] }} {
{% for member in attribute.type.members %}
  {{ member.id | screaming_snake_case }} = "{{ member.value }}",
{% endfor %}
{% for member in enum["extra"] %}
  {{ member["name"] }} = "{{ member["value"] }}",
{% endfor %}
}
{% endfor %}
{% endfor %}
