{
  "name": "@arizeai/openinference-instrumentation-typesafe",
  "version": "0.2.1",
  "private": false,
  "description": "OpenInference instrumentation for the TypeSafe AI SDK",
  "keywords": [
    "ai",
    "instrumentation",
    "llm",
    "openinference",
    "opentelemetry",
    "typesafe"
  ],
  "license": "Apache-2.0",
  "author": "oss-devs@arize.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arize-ai/openinference.git",
    "directory": "js/packages/openinference-instrumentation-typesafe"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/src/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rimraf dist && pnpm run version:update",
    "build": "tsc --build tsconfig.json tsconfig.esm.json && tsc-alias -p tsconfig.esm.json",
    "postbuild": "echo '{\"type\": \"module\"}' > ./dist/esm/package.json",
    "version:update": "../../scripts/version-update.js",
    "type:check": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@arizeai/openinference-core": "workspace:*",
    "@arizeai/openinference-semantic-conventions": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/instrumentation": "^0.46.0",
    "@opentelemetry/semantic-conventions": "^1.37.0"
  },
  "devDependencies": {
    "@arizeai/openinference-instrumentation-openai": "workspace:*",
    "@opentelemetry/context-async-hooks": "^2.2.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.207.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@types/node": "^20.14.11",
    "@typesafe-ai/sdk": "0.6.0",
    "openai": "6.7.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "zod": "^3.24.3"
  },
  "peerDependencies": {
    "@typesafe-ai/sdk": ">=0.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
